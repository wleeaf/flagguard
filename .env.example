TELEGRAM_TOKEN=
ADMIN_IDS=
SERVICE_ACCOUNT_PATH=api.json
CHALLENGE_FLAG=FLAG{your_flag_here}
BOT_NAME=AIShield
FLAG_PREFIX=FLAG
APP_TIMEZONE_OFFSET=+00:00

# Bot mode: "polling" (default) or "webhook"
BOT_MODE=polling
# WEBHOOK_URL=https://yourdomain.com  # required when BOT_MODE=webhook
# WEBHOOK_PATH=/webhook
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8443
# WEBHOOK_REUSE_PORT=true
# WEBHOOK_SECRET_TOKEN=  # REQUIRED in production webhook mode (>= 16 chars; setWebhook secret_token)
# WEBHOOK_MAX_CONNECTIONS=40   # Telegram setWebhook max_connections (1..100)
# WEBHOOK_REGISTER_ON_START=true  # Set false on most workers to avoid repeated setWebhook calls
APP_ENV=development

# AI runtime tuning (optional)
# AI_API_TIMEOUT_SECONDS=15
# AI_RETRY_ATTEMPTS=2
# AI_RETRY_BASE_DELAY_SECONDS=1.0
# AI_CIRCUIT_BREAKER_THRESHOLD=10
# AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# AI_MAX_CONCURRENT_REQUESTS=8  # Default is 50 (dev) / 8 (prod webhook)
# AI_DB_MAX_CONCURRENT_OPS=128
# AI_DEFERRED_WRITE_WORKERS=8
# AI_DEFERRED_WRITE_QUEUE_SIZE=5000
# KNOWN_USER_UPSERT_INTERVAL_SECONDS=60
# LOGIC_RATE_LIMIT_WINDOW_SECONDS=60
# TELEGRAM_SEND_CONCURRENCY=20
# TELEGRAM_MIN_SEND_INTERVAL_SECONDS=0.04
# TELEGRAM_SEND_MAX_RETRIES=3
# AI_GLOBAL_RPM_LIMIT=800  # Global Gemini request budget across ALL bot workers (0 disables; default is 800 in production)
# AI_OVERLOAD_QUEUE_THRESHOLD=200  # Pending updates per worker before fail-fast
# AI_OVERLOAD_REPLY_TEXT=Sistem su an yogun. Lutfen biraz sonra tekrar dene.
# BOT_THREADPOOL_MAX_WORKERS=64  # Default is 64 (both dev and prod webhook)
# LOG_LEVEL=INFO
# LOG_RETENTION_DAYS=30  # Auto-delete conversation_logs and message_log older than this
# BOT_LOG_FILE=challenge.log  # logs to challenge-{pid}.log (omit for journald/stdout)
# FLAG_SUCCESS_URL=https://example.com  # URL shown when a user solves the flag

# Attachment budget across all files in a single message
# MAX_TOTAL_ATTACHMENT_BYTES=37748736

# Database (PostgreSQL — required)
DATABASE_URL=postgresql://user:pass@localhost:5432/aishield
# DATABASE_POOL_MIN_SIZE=2   # Default: 2 (prod webhook), 1 (dev/polling)
# DATABASE_POOL_MAX_SIZE=25  # Default: 25 (prod webhook), 10 (dev/polling)

# Test database (used by pytest)
# TEST_DATABASE_URL=postgresql://aishield:testpass@localhost:5432/aishield_test

# Shared logic rate limiter backend:
# - auto: always uses database (PostgreSQL-backed)
# - memory: in-process only
# - database: shared via user_requests table
# RATE_LIMIT_BACKEND=memory  # Default: "memory" (low DB pressure). Use "database" for cross-process shared limiting.

# Panel (optional — only needed if running the web panel)
PANEL_SECRET_KEY=change-me-in-production  # REQUIRED: replace with a strong random secret (e.g. openssl rand -hex 32)
PANEL_PORT=8000
PANEL_HOST=127.0.0.1
PANEL_COOKIE_SECURE=true
# PANEL_WORKERS=1
# PANEL_BACKUP_DIR=backups
# PANEL_BACKUP_RETENTION=20
# PANEL_BACKUP_TIMEOUT_SECONDS=180

# Metrics multi-process export (recommended when running multiple workers)
# METRICS_EXPORT_DIR=/tmp/aishield-metrics
# METRICS_EXPORT_INTERVAL_SECONDS=5
# METRICS_EXPORT_MAX_AGE_SECONDS=30

# Hot-path message logging (async batch insert to reduce DB load)
# MESSAGE_LOG_ASYNC=true
# MESSAGE_LOG_QUEUE_SIZE=5000
# MESSAGE_LOG_BATCH_SIZE=200
# MESSAGE_LOG_FLUSH_INTERVAL_SECONDS=0.2

# ==========================================
# 🐳 DOCKER COMPOSE (OPTIONAL)
# ==========================================
#
# Used by docker-compose.yml / docker-compose.prod.yml variable interpolation.
# DOMAIN=example.com
# POSTGRES_USER=aishield
# POSTGRES_PASSWORD=change-me  # Set a strong password in production
# POSTGRES_DB=aishield
# BOT_WEBHOOK_WORKERS=8
# DOCKER_DB_WAIT_TIMEOUT_SECONDS=60
